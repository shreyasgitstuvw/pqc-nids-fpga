{
  "_comment": "Member B's copy. Copy this to ~/.gemini/antigravity-cli/settings.json on Member B's machine only \u2014 each member gets their own lettered file (antigravity-settings-b.json), not the generic one. This adds a hard block on pushing to any other member's branch namespace (member-a|c|d/*), on top of the shared rules everyone runs. Precedence is Deny > Ask > Allow.",
  "toolPermission": "proceed-in-sandbox",
  "enableTerminalSandbox": true,
  "permissions": {
    "deny": [
      "write_file(sim/vectors/)",
      "write_file(model/mlkem/)",
      "write_file(model/sha3.py)",
      "write_file(.git/)",
      "command(regex:git\\s+push\\s+.*(--force|--force-with-lease|-f)\\b)",
      "command(regex:git\\s+push\\s+\\S+\\s+main\\b)",
      "command(regex:git\\s+push\\s+origin\\s+HEAD:main)",
      "command(regex:git\\s+push\\b.*\\bmember-(a|c|d)/)",
      "command(regex:git\\s+reset\\s+--hard)",
      "command(regex:git\\s+clean\\s+-[a-zA-Z]*f)",
      "command(regex:git\\s+branch\\s+-D)",
      "command(regex:git\\s+filter-branch)",
      "command(regex:git\\s+config\\s+--global)",
      "command(regex:git\\s+remote\\s+(set-url|remove|rm))",
      "command(regex:gh\\s+repo\\s+delete)",
      "command(regex:rm\\s+-rf)",
      "command(sudo)"
    ],
    "ask": [
      "command(git add)",
      "command(git commit)",
      "command(git push)",
      "command(git pull)",
      "command(git merge)",
      "command(git rebase)",
      "command(git checkout)",
      "command(git switch)",
      "command(git restore)",
      "command(git stash)",
      "command(git revert)",
      "command(git cherry-pick)",
      "command(gh pr create)",
      "command(gh pr merge)"
    ],
    "allow": [
      "command(git status)",
      "command(git log)",
      "command(git diff)",
      "command(git show)",
      "command(git fetch)",
      "command(git branch)",
      "command(git remote)",
      "command(git rev-parse)",
      "command(git rev-list)",
      "command(git ls-files)",
      "command(git blame)",
      "command(git shortlog)",
      "command(git describe)",
      "command(git merge-base)",
      "command(gh pr list)",
      "command(gh pr view)",
      "command(gh pr diff)",
      "command(gh repo view)",
      "command(gh run list)",
      "command(gh run view)",
      "command(python)",
      "command(verilator)",
      "command(make)",
      "command(pytest)"
    ]
  }
}
